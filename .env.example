# SQLite database file (relative to prisma/)
DATABASE_URL="file:./dev.db"

# Key used to derive the AES-256-GCM encryption key for stored passwords/tokens.
# Use a long random string in production. Changing it makes existing ciphertext unreadable.
APP_SECRET="replace-with-a-long-random-secret"

# Password for the single-admin login gate.
ADMIN_PASSWORD="change-me"

# Public URL used for deployment documentation and future absolute links.
NEXT_PUBLIC_APP_URL="https://outlook.2963wang.shop"

# Auto keep-alive: periodically refresh (rotate) refresh tokens so they never
# hit the ~90-day inactivity limit. Set KEEP_ALIVE_ENABLED=0 to turn off.
KEEP_ALIVE_ENABLED="1"
KEEP_ALIVE_INTERVAL_HOURS="168"          # 168h = every 7 days
NEXT_PUBLIC_KEEP_ALIVE_INTERVAL_HOURS="168"  # shown in the UI banner
