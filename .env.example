# Dedicated Outlook Mail Manager PostgreSQL database.
DATABASE_URL="postgresql://outlook:replace-database-password@postgres:5432/outlook_manager?schema=public"
POSTGRES_DB="outlook_manager"
POSTGRES_USER="outlook"
POSTGRES_PASSWORD="replace-database-password"

# Public application URL. The Microsoft redirect URI is derived from this URL.
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# V2 keys are independent. Local development may set values here. Production
# Compose reads the corresponding files from ./secrets instead.
SESSION_SIGNING_KEY="replace-with-a-random-session-signing-key"
DATA_ENCRYPTION_KEYS="v1:replace-with-a-random-data-encryption-key"
CARD_KEY_HMAC_KEY="replace-with-a-random-card-key-hmac-key"
ADMIN_BOOTSTRAP_PASSWORD="change-me"

# Managed Microsoft OAuth (optional until standard OAuth onboarding is enabled).
# Register a web redirect URI: <NEXT_PUBLIC_APP_URL>/api/v2/oauth/microsoft/callback
MICROSOFT_CLIENT_ID=""
MICROSOFT_CERTIFICATE_PATH="/run/secrets/microsoft_certificate"
MICROSOFT_PRIVATE_KEY_PATH="/run/secrets/microsoft_private_key"
MICROSOFT_CERTIFICATE_THUMBPRINT=""

# Web / worker runtime.
WORKER_ID="worker-1"
WORKER_POLL_INTERVAL_MS="2000"
WORKER_CONCURRENCY="10"
OAUTH_CONCURRENCY="2"
GRAPH_CONCURRENCY="10"
IMAP_CONCURRENCY="5"
LOG_LEVEL="info"
# Optional OTLP/HTTP base URL, for example http://otel-collector:4318.
# Web and Worker append /v1/traces automatically.
OTEL_EXPORTER_OTLP_ENDPOINT=""
METRICS_BEARER_TOKEN="replace-with-a-random-internal-metrics-token"
