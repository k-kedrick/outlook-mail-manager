generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountType {
  UNKNOWN
  PERSONAL
  ORGANIZATION
}

enum MailProtocol {
  GRAPH
  IMAP
  OUTLOOK_REST_LEGACY
}

enum OAuthResource {
  GRAPH
  OUTLOOK_IMAP
  OUTLOOK_REST_LEGACY
  IMPORTED_MULTI_RESOURCE
}

enum OAuthGrantSource {
  MANAGED
  IMPORTED
}

enum OAuthGrantStatus {
  ACTIVE
  REAUTH_REQUIRED
  REVOKED
  ERROR
}

enum AccessTokenProfile {
  GRAPH_MAIL
  IMAP_MAIL
  OUTLOOK_REST_LEGACY
}

enum CapabilityState {
  UNKNOWN
  AVAILABLE
  DENIED
  DISABLED
  TEMPORARY_FAILURE
}

enum JobStatus {
  PENDING
  RUNNING
  RETRY
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AuditOutcome {
  SUCCEEDED
  FAILED
  DENIED
}

enum CodeRequestStatus {
  PENDING
  RUNNING
  FOUND
  EXPIRED
  FAILED
}

model AdminUser {
  id                String         @id @default(cuid())
  username          String         @unique @default("admin")
  passwordHash      String
  totpSecretCipher  String?
  totpConfirmedAt   DateTime?
  sessionVersion    Int            @default(1)
  bootstrapComplete Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sessions          AdminSession[]
  recoveryCodes     RecoveryCode[]
  oauthFlows        OAuthFlow[]
  auditEvents       AuditEvent[]
}

model AdminSession {
  id             String    @id @default(cuid())
  adminId        String
  tokenHash      String    @unique
  csrfHash       String
  sessionVersion Int
  expiresAt      DateTime
  lastSeenAt     DateTime  @default(now())
  ipHash         String?
  userAgentHash  String?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  admin          AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId, expiresAt])
  @@index([expiresAt])
}

model RecoveryCode {
  id        String    @id @default(cuid())
  adminId   String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([adminId, codeHash])
}

model MailAccount {
  id                String        @id @default(cuid())
  email             String        @unique
  normalizedEmail   String        @unique
  providerSubject   String?
  tenantId          String?
  issuer            String?
  accountType       AccountType   @default(UNKNOWN)
  preferredProtocol MailProtocol?
  status            String        @default("UNKNOWN")
  lastCheckedAt     DateTime?
  lastErrorCode     String?
  lastError         String?
  note              String?
  groupId           String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  rowVersion        Int           @default(1)

  group        MailGroup?           @relation(fields: [groupId], references: [id], onDelete: SetNull)
  cardKey      CardKey?
  secret       AccountSecret?
  oauthGrants  OAuthGrant[]
  capabilities ProtocolCapability[]
  jobs         Job[]
  codeRequests CodeRequest[]

  @@unique([issuer, providerSubject])
  @@index([status])
  @@index([groupId])
  @@index([tenantId])
  @@index([preferredProtocol])
}

model AccountSecret {
  accountId      String      @id
  passwordCipher String?
  totpCipher     String?
  keyId          String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  account        MailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model OAuthGrant {
  id                    String             @id @default(cuid())
  accountId             String
  resource              OAuthResource
  source                OAuthGrantSource
  status                OAuthGrantStatus   @default(ACTIVE)
  clientId              String
  tenantId              String?
  refreshTokenCipher    String
  grantedScopes         String[]
  keyId                 String
  version               Int                @default(1)
  lastRotatedAt         DateTime?
  lastVerifiedAt        DateTime?
  nextMaintenanceAt     DateTime?
  providerExpiresAt     DateTime?
  refreshLeaseOwner     String?
  refreshLeaseExpiresAt DateTime?
  lastErrorCode         String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  account               MailAccount        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessTokens          AccessTokenCache[]

  @@unique([accountId, resource, clientId])
  @@index([status, nextMaintenanceAt])
  @@index([refreshLeaseExpiresAt])
}

model AccessTokenCache {
  id          String             @id @default(cuid())
  grantId     String
  profile     AccessTokenProfile
  tokenCipher String
  keyId       String
  expiresAt   DateTime
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  grant       OAuthGrant         @relation(fields: [grantId], references: [id], onDelete: Cascade)

  @@unique([grantId, profile])
  @@index([expiresAt])
}

model ProtocolCapability {
  id                  String          @id @default(cuid())
  accountId           String
  protocol            MailProtocol
  state               CapabilityState @default(UNKNOWN)
  consecutiveFailures Int             @default(0)
  lastProbedAt        DateTime?
  lastSuccessAt       DateTime?
  lastFailureAt       DateTime?
  lastErrorCode       String?
  circuitOpenUntil    DateTime?
  retryAfterAt        DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  account             MailAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, protocol])
  @@index([state, circuitOpenUntil])
}

model OAuthFlow {
  id                 String        @id @default(cuid())
  adminId            String
  accountId          String?
  resource           OAuthResource
  stateHash          String        @unique
  nonceHash          String
  pkceVerifierCipher String
  expectedSubject    String?
  expectedTenantId   String?
  expiresAt          DateTime
  consumedAt         DateTime?
  createdAt          DateTime      @default(now())
  admin              AdminUser     @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model CardKey {
  id           String        @id @default(cuid())
  codeHash     String        @unique
  codePrefix   String?
  codeLast4    String?
  accountId    String        @unique
  account      MailAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  codeRequests CodeRequest[]
}

model MailGroup {
  id        String        @id @default(cuid())
  name      String        @unique
  color     String?
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  accounts  MailAccount[]
}

model Job {
  id             String       @id @default(cuid())
  type           String
  status         JobStatus    @default(PENDING)
  accountId      String?
  dedupeKey      String?      @unique
  payload        Json
  result         Json?
  priority       Int          @default(0)
  runAt          DateTime     @default(now())
  attempts       Int          @default(0)
  maxAttempts    Int          @default(5)
  leaseOwner     String?
  leaseExpiresAt DateTime?
  lastErrorCode  String?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  account        MailAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  jobAttempts    JobAttempt[]

  @@index([status, runAt, priority])
  @@index([leaseExpiresAt])
  @@index([accountId, status])
}

model JobAttempt {
  id          String    @id @default(cuid())
  jobId       String
  attempt     Int
  workerId    String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?
  outcome     JobStatus
  errorCode   String?
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, attempt])
  @@index([startedAt])
}

model AuditEvent {
  id         String       @id @default(cuid())
  adminId    String?
  action     String
  targetType String?
  targetId   String?
  outcome    AuditOutcome
  requestId  String
  ipHash     String?
  metadata   Json?
  createdAt  DateTime     @default(now())
  admin      AdminUser?   @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([requestId])
}

model WorkerHeartbeat {
  workerId    String   @id
  version     String
  concurrency Int
  lastSeenAt  DateTime @default(now())
  startedAt   DateTime @default(now())
}

model CodeRequest {
  id                 String            @id @default(cuid())
  accountId          String
  cardKeyId          String?
  retrievalTokenHash String            @unique
  status             CodeRequestStatus @default(PENDING)
  resultCodeCipher   String?
  resultKeyId        String?
  resultSubject      String?
  resultFrom         String?
  resultReceivedAt   DateTime?
  lastErrorCode      String?
  expiresAt          DateTime
  completedAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  account            MailAccount       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  cardKey            CardKey?          @relation(fields: [cardKeyId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([accountId, createdAt])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  keyHash     String
  windowStart DateTime
  count       Int      @default(1)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([keyHash, windowStart])
  @@index([expiresAt])
}
